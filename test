declare(strict_types=1);

namespace App\Service;

use App\Entity\Wallet;
use Doctrine\ORM\EntityManagerInterface;

class WalletService
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager
    ) {}
    
    public function transfer(int $fromWalletId, int $toWalletId, float $amount): bool
    {
        // ❌ PROBLÈME SUBTIL : Race condition possible
        // Si deux transferts se font en même temps depuis le même wallet,
        // les deux peuvent lire le même solde avant qu'il soit mis à jour
        
        $fromWallet = $this->entityManager->find(Wallet::class, $fromWalletId);
        $toWallet = $this->entityManager->find(Wallet::class, $toWalletId);
        
        if ($fromWallet === null || $toWallet === null) {
            return false;
        }
        
        // ❌ PROBLÈME : Pas de verrouillage pessimiste (LOCK IN SHARE MODE ou FOR UPDATE)
        if ($fromWallet->getBalance() < $amount) {
            return false;
        }
        
        // ❌ PROBLÈME : Entre ces deux lignes, un autre process pourrait modifier le solde
        $fromWallet->setBalance($fromWallet->getBalance() - $amount);
        $toWallet->setBalance($toWallet->getBalance() + $amount);
        
        // ❌ PROBLÈME : Pas de transaction explicite
        // Si le flush échoue après avoir débité mais avant d'avoir crédité,
        // l'argent disparaît
        $this->entityManager->flush();
        
        return true;
    }
    
