declare(strict_types=1);

namespace App\Service;

use App\Entity\Article;
use App\Repository\ArticleRepository;
use Doctrine\ORM\EntityManagerInterface;

class ArticleAnalyticService
{
    public function __construct(
        private readonly ArticleRepository $articleRepository,
        private readonly EntityManagerInterface $entityManager
    ) {}
    
    public function generateMonthlyReport(): array
    {
        // ❌ PROBLÈME TRÈS SUBTIL : N+1 queries et memory leak
        
        // Récupère tous les articles (peut être 100 000+)
        $articles = $this->articleRepository->findAll();
        
        $report = [];
        
        foreach ($articles as $article) {
            // ❌ PROBLÈME 1 : N+1 Query
            // Pour chaque article, Doctrine va faire une requête séparée
            // pour charger les commentaires (lazy loading)
            $commentCount = count($article->getComments());
            
            // ❌ PROBLÈME 2 : N+1 Query encore
            // Pour chaque article, requête pour charger l'auteur
            $authorName = $article->getAuthor()->getName();
            
            // ❌ PROBLÈME 3 : N+1 Query supplémentaire
            // Pour chaque article, requête pour les tags
            $tags = [];
            foreach ($article->getTags() as $tag) {
                $tags[] = $tag->getName();
            }
            
            // ❌ PROBLÈME 4 : Memory Leak
            // Les entités restent en mémoire, pas de clear()
            // Avec 100 000 articles, PHP va manquer de mémoire
            
            $report[] = [
                'title' => $article->getTitle(),
                'author' => $authorName,
                'comments' => $commentCount,
                'tags' => $tags,
                'views' => $article->getViews()
            ];
        }
        
        return $report;
        
        // ❌ RÉSULTAT : Au lieu de 1 requête, on a potentiellement :
        // 1 (articles) + N (authors) + N (comments count) + N*M (tags) requêtes
        // Pour 1000 articles avec 5 tags chacun = 1 + 1000 + 1000 + 5000 = 7001 requêtes !
        // Et PHP crashe avec Out of Memory après ~10 000 articles
    }
    
